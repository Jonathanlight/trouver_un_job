{
  "manifest_version": 3,
  "name": "TrouverUnJob",
  "version": "1.4.0",
  "description": "Détectez les arnaques et analysez les offres d'emploi sur Indeed, LinkedIn, HelloWork et WTTJ.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.indeed.com/*",
    "*://*.indeed.fr/*",
    "*://*.linkedin.com/*",
    "*://*.hellowork.com/*",
    "*://*.hellowork.io/*",
    "*://*.welcometothejungle.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.indeed.fr/*"
      ],
      "js": ["content-scripts/shared/i18n-content.js", "content-scripts/shared/pertinence-analyzer.js", "content-scripts/shared/career-pathways.js", "content-scripts/indeed.js"],
      "css": ["content-scripts/styles.css"]
    },
    {
      "matches": [
        "*://*.linkedin.com/jobs/*"
      ],
      "js": ["content-scripts/shared/i18n-content.js", "content-scripts/shared/pertinence-analyzer.js", "content-scripts/shared/career-pathways.js", "content-scripts/linkedin.js"],
      "css": ["content-scripts/styles.css"]
    },
    {
      "matches": [
        "*://*.hellowork.com/*",
        "*://*.hellowork.io/*"
      ],
      "js": ["content-scripts/shared/i18n-content.js", "content-scripts/shared/pertinence-analyzer.js", "content-scripts/shared/career-pathways.js", "content-scripts/hellowork.js"],
      "css": ["content-scripts/styles.css"]
    },
    {
      "matches": [
        "*://*.welcometothejungle.com/*"
      ],
      "js": ["content-scripts/shared/i18n-content.js", "content-scripts/shared/pertinence-analyzer.js", "content-scripts/shared/career-pathways.js", "content-scripts/welcometothejungle.js"],
      "css": ["content-scripts/styles.css"]
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["locales/*.json", "locales/i18n.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
