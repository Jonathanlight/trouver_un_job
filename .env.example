# =============================================================================
# FAKE JOB DETECTOR - Configuration
# =============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins

# -----------------------------------------------------------------------------
# MODE & DEBUG
# -----------------------------------------------------------------------------
NODE_ENV=development
DEBUG_MODE=false
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# ANALYSE - Seuils de score
# -----------------------------------------------------------------------------
# Score minimum pour considérer une offre comme suspecte
SCORE_THRESHOLD_SUSPECT=30

# Score minimum pour considérer une offre comme dangereuse
SCORE_THRESHOLD_DANGER=50

# Score minimum pour considérer une offre comme arnaque
SCORE_THRESHOLD_SCAM=70

# -----------------------------------------------------------------------------
# LINKEDIN - Configuration spécifique
# -----------------------------------------------------------------------------
# Seuil de candidatures pour détecter un ghost job
LINKEDIN_GHOST_JOB_APPLICANTS=300

# Seuil critique de candidatures
LINKEDIN_CRITICAL_APPLICANTS=500

# Activer l'analyse des candidatures
LINKEDIN_ANALYZE_APPLICANTS=true

# -----------------------------------------------------------------------------
# INDEED - Configuration spécifique
# -----------------------------------------------------------------------------
# Analyser les offres marquées "urgentes"
INDEED_FLAG_URGENT=true

# Poids additionnel pour les offres urgentes
INDEED_URGENT_WEIGHT=15

# -----------------------------------------------------------------------------
# DONNÉES MARCHÉ - Ajustements salaires (multiplicateurs)
# -----------------------------------------------------------------------------
# Multiplicateur pour Paris/Île-de-France
MARKET_MULTIPLIER_PARIS=1.15

# Multiplicateur pour grandes villes (Lyon, Marseille, etc.)
MARKET_MULTIPLIER_GRANDES_VILLES=1.05

# Multiplicateur pour autres régions
MARKET_MULTIPLIER_REGIONS=0.95

# -----------------------------------------------------------------------------
# AGENTS IA - Configuration
# -----------------------------------------------------------------------------
# Activer l'agent de détection d'arnaques
AGENT_SCAM_DETECTOR_ENABLED=true
AGENT_SCAM_DETECTOR_WEIGHT=1.5

# Activer l'agent de cohérence
AGENT_COHERENCE_ENABLED=true
AGENT_COHERENCE_WEIGHT=1.2

# Activer l'agent de comparaison marché
AGENT_MARKET_ENABLED=true
AGENT_MARKET_WEIGHT=1.0

# Activer l'agent de professionnalisme
AGENT_PROFESSIONALISM_ENABLED=true
AGENT_PROFESSIONALISM_WEIGHT=0.8

# Activer l'agent ghost job
AGENT_GHOST_JOB_ENABLED=true
AGENT_GHOST_JOB_WEIGHT=1.1

# -----------------------------------------------------------------------------
# MCP SERVER - Configuration
# -----------------------------------------------------------------------------
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# Activer le cache des analyses
MCP_CACHE_ENABLED=true
MCP_CACHE_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# NOTIFICATIONS
# -----------------------------------------------------------------------------
# Afficher les notifications pour les offres suspectes
NOTIFICATIONS_ENABLED=true

# Notification sonore pour les arnaques
NOTIFICATIONS_SOUND=false

# -----------------------------------------------------------------------------
# STOCKAGE
# -----------------------------------------------------------------------------
# Durée de conservation des analyses (en heures)
STORAGE_ANALYSIS_TTL_HOURS=24

# Nombre maximum d'analyses conservées
STORAGE_MAX_ANALYSES=1000

# -----------------------------------------------------------------------------
# API EXTERNES (optionnel - pour enrichissement)
# -----------------------------------------------------------------------------
# API de vérification d'entreprises (ex: Societe.com, Pappers)
# COMPANY_VERIFICATION_API_KEY=your_api_key_here
# COMPANY_VERIFICATION_API_URL=https://api.example.com/verify

# API de données marché (ex: Glassdoor, PayScale)
# MARKET_DATA_API_KEY=your_api_key_here
# MARKET_DATA_API_URL=https://api.example.com/salaries

# -----------------------------------------------------------------------------
# WEBHOOK (optionnel - pour intégrations)
# -----------------------------------------------------------------------------
# URL du webhook pour recevoir les alertes
# WEBHOOK_URL=https://your-webhook-url.com/alerts
# WEBHOOK_SECRET=your_webhook_secret